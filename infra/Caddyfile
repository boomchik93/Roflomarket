{$DOMAIN} {
	encode zstd gzip

	@api path /api/* /ws
	handle @api {
		reverse_proxy {
			# Re-resolve replicas through Docker DNS so restarted containers are picked up.
			dynamic a gateway 3000 {
				refresh 5s
			}
			# Retry another replica while one is restarting during a deploy.
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
		}
	}

	handle {
		reverse_proxy {
			dynamic a web 80 {
				refresh 5s
			}
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
		}
	}
}
