# Copy to /opt/roflomarket/.env on the VPS and fill in real values. Never commit the real file.
DOMAIN=roflomarket.example.com

POSTGRES_USER=roflo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roflo

DATABASE_URL=postgres://roflo:change-me@postgres:5432/roflo?sslmode=disable
ENGINE_URL=http://engine:8080
SESSION_SECRET=change-me
